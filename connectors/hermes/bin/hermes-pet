#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="${HERMES_PET_PROJECT_ROOT:-}"
PROJECT_ROOT_FILE="${HOME}/.hermes/skills/productivity/hermes-pet/.project-root"
if [ -z "$PROJECT_ROOT" ] && [ -f "$PROJECT_ROOT_FILE" ]; then
  PROJECT_ROOT="$(sed -n '1p' "$PROJECT_ROOT_FILE")"
fi

if [ -n "$PROJECT_ROOT" ] && [ -x "${PROJECT_ROOT}/venv/bin/python3" ] && [ -f "${PROJECT_ROOT}/hermes_pet/cli.py" ]; then
  cd "$PROJECT_ROOT"
  exec "${PROJECT_ROOT}/venv/bin/python3" -m hermes_pet.cli "$@"
fi

exec hermes pet "$@"
